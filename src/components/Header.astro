---
import { EMAIL, NAV, SITE_TITLE, WECHAT_QR } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
	<div class="wrap">
		<a class="brand" href="/">
			<svg class="lantern" viewBox="0 0 24 32" aria-hidden="true">
				<path d="M12 1v4" />
				<path d="M8 5h8" />
				<path class="glow" d="M6 9c0-2 2.5-4 6-4s6 2 6 4v12c0 2-2.5 4-6 4s-6-2-6-4z" />
				<path d="M7 9h10M7 21h10" />
				<path d="M10 25v2h4v-2M12 27v4" />
			</svg>
			<span>{SITE_TITLE}</span>
		</a>
		<nav>
			{NAV.map(({ href, label }) => (
				<a href={href} class:list={{ active: isActive(href) }}>{label}</a>
			))}
			{EMAIL && (
				<div class="contact">
					<button class="icon-btn" type="button" aria-label="邮箱" aria-expanded="false">
						<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" /></svg>
					</button>
					<div class="pop" role="dialog" aria-label="邮箱">
						<p class="pop-title">给我写信</p>
						<a class="mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
						<button type="button" class="copy" data-copy={EMAIL}>复制地址</button>
					</div>
				</div>
			)}
			{WECHAT_QR && (
				<div class="contact">
					<button class="icon-btn" type="button" aria-label="微信" aria-expanded="false">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 4C5.4 4 2 6.8 2 10.2c0 1.9 1 3.6 2.7 4.7L4 17.5l2.9-1.5c.8.2 1.7.4 2.6.4" /><path d="M15.5 9.5c3.6 0 6.5 2.4 6.5 5.4 0 1.6-.9 3.1-2.3 4.1l.6 2.2-2.5-1.3c-.7.2-1.5.3-2.3.3-3.6 0-6.5-2.4-6.5-5.3s2.9-5.4 6.5-5.4z" /><circle cx="7" cy="9.3" r=".6" /><circle cx="12" cy="9.3" r=".6" /><circle cx="13.4" cy="14.3" r=".5" /><circle cx="17.6" cy="14.3" r=".5" /></svg>
					</button>
					<div class="pop" role="dialog" aria-label="微信">
						<p class="pop-title">微信扫一扫，加我好友</p>
						<img src={WECHAT_QR} width="180" height="180" alt="微信二维码" loading="lazy" />
					</div>
				</div>
			)}
			<button id="theme-toggle" class="icon-btn" type="button" aria-label="切换深色/浅色">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
				</svg>
			</button>
		</nav>
	</div>
</header>

<script is:inline>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const root = document.documentElement;
		const dark = root.dataset.theme
			? root.dataset.theme === 'dark'
			: matchMedia('(prefers-color-scheme: dark)').matches;
		const next = dark ? 'light' : 'dark';
		root.dataset.theme = next;
		try { localStorage.setItem('theme', next); } catch {}
	});

	// 邮箱 / 微信 弹出框：点图标开关，点别处或按 Esc 关闭
	(() => {
		const boxes = [...document.querySelectorAll('.contact')];
		const closeAll = (except) => boxes.forEach((b) => {
			if (b === except) return;
			b.classList.remove('open');
			b.querySelector('.icon-btn').setAttribute('aria-expanded', 'false');
		});
		boxes.forEach((b) => b.querySelector('.icon-btn').addEventListener('click', (e) => {
			e.stopPropagation();
			closeAll(b);
			const open = b.classList.toggle('open');
			e.currentTarget.setAttribute('aria-expanded', String(open));
		}));
		document.addEventListener('click', (e) => { if (!e.target.closest('.pop')) closeAll(); });
		document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
		document.querySelectorAll('.pop .copy').forEach((btn) => btn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(btn.dataset.copy);
				btn.textContent = '已复制 ✓';
			} catch {
				btn.textContent = '请手动复制';
			}
			setTimeout(() => (btn.textContent = '复制地址'), 1500);
		}));
	})();
</script>

<style>
	.site-header {
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: blur(8px);
		position: sticky;
		top: 0;
		z-index: 10;
	}
	.wrap {
		max-width: var(--max);
		margin: 0 auto;
		padding: 0 16px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--serif);
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--ink);
		text-decoration: none;
		letter-spacing: 0.1em;
		white-space: nowrap;
	}
	.lantern {
		width: 18px;
		height: 24px;
		fill: none;
		stroke: var(--ink);
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.lantern .glow {
		fill: var(--accent);
		fill-opacity: 0.85;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 2px;
	}
	nav a {
		padding: 6px 10px;
		border-radius: 6px;
		color: var(--muted);
		text-decoration: none;
		font-size: 0.95rem;
		white-space: nowrap;
	}
	nav a:hover {
		color: var(--ink);
		background: var(--soft);
	}
	nav a.active {
		color: var(--ink);
		font-weight: 600;
	}
	.icon-btn {
		margin-left: 4px;
		width: 34px;
		height: 34px;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 6px;
		background: none;
		cursor: pointer;
		color: var(--muted);
	}
	.icon-btn:hover {
		background: var(--soft);
		color: var(--ink);
	}
	.icon-btn svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
	}
	.icon-btn svg circle {
		fill: currentColor;
		stroke: none;
	}
	.contact {
		position: relative;
	}
	.pop {
		display: none;
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		z-index: 20;
		padding: 14px 16px;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--bg);
		box-shadow: 0 8px 28px rgb(0 0 0 / 0.12);
		text-align: center;
		white-space: nowrap;
	}
	.contact.open .pop {
		display: block;
	}
	.contact.open .icon-btn {
		color: var(--accent);
	}
	.pop-title {
		margin: 0 0 8px;
		color: var(--muted);
		font-size: 0.85rem;
	}
	.pop img {
		display: block;
		width: 180px;
		height: 180px;
		border-radius: 6px;
		background: #fff;
	}
	.pop .mail {
		display: block;
		color: var(--ink);
		font-weight: 600;
		text-decoration: none;
	}
	.pop .copy {
		margin-top: 10px;
		padding: 4px 12px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: none;
		color: var(--muted);
		cursor: pointer;
		font-size: 0.85rem;
	}
	.pop .copy:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	@media (max-width: 480px) {
		.icon-btn {
			width: 30px;
			margin-left: 0;
		}
		.pop {
			right: -40px;
		}
		nav a {
			padding: 6px 5px;
			font-size: 0.9rem;
		}
		.brand {
			letter-spacing: 0.04em;
			gap: 6px;
		}
	}
</style>
